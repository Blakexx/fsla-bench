"""fsla-bench's root package: its checks and gate (the tracked tree beside them: fsla_bench/, tests/, declare.py hold no
BUILD file, so their files are this package's)."""

load("@fsla_devtools//bazel:rules.bzl", "bazel_version_test")
load("//bazel:defs.bzl", "bench_python", "docrefs_test", "research_python", "tree_part", "tree_test")

exports_files([
    "requirements.lock",
    "research.lock",
])

#: this package's part of the tree, and the whole tree
tree_part()

filegroup(
    name = "tree",
    srcs = [
        ":tracked",
        "//bazel:tracked",
    ],
)

#: fsla's rule set, over the bench package and its tests
tree_test(
    name = "ruff",
    size = "small",
    cmd = ["ruff", "check", "--select", "E,F,UP,B,SIM,I,C4", "--line-length", "127", "--target-version", "py310",
           "fsla_bench", "tests", "declare.py"],
    data = [":tree"],
)

tree_test(
    name = "ruff_e3",
    size = "small",
    #: ruff's blank-line family is preview-gated, so its own invocation
    cmd = ["ruff", "check", "--preview", "--select", "E3", "--line-length", "127", "--target-version", "py310",
           "fsla_bench", "tests", "declare.py"],
    data = [":tree"],
)

#: the measurement composer's contract: the suite composes each fsla checkout's declarations as declared
tree_test(
    name = "suite_contract",
    size = "small",
    cmd = ["python3", "-m", "unittest", "tests.measure.test_suite"],
    data = [":tree"],
)

tree_test(
    name = "declarations",
    size = "small",
    cmd = ["python3", "-m", "fsla_devtools.mirror", "--check"],
    data = [":tree"],
    git = True,
)

#: every citation the docs make of the tree pinned and read (fsla-devtools' `fsla_devtools.docrefs`): a dotted name
#: resolves under the package and the tests
docrefs_test(
    name = "docrefs",
    size = "small",
    lock = "references.lock.json",
    packages = {
        "fsla_bench": "",
        "tests": "",
    },
)

#: .bazelversion is the Bazel release fsla-devtools' shared pins are tested with
bazel_version_test(
    name = "bazelversion",
    version = ".bazelversion",
)

#: THE GATE: every check this workspace holds; the commit hook runs it (.githooks/pre-commit)
test_suite(
    name = "gate",
    tests = [
        ":bazelversion",
        ":declarations",
        ":docrefs",
        ":ruff",
        ":ruff_e3",
        ":suite_contract",
    ],
)

#: THE RUNS (README.md#local-runs): each environment's interpreter, and the documented commands. A run that imports fsla
#: takes the fsla checkout as its first argument, its library built (`bazel run //:mqar_smoke -- <fsla checkout>`).
bench_python(name = "bench_python")

research_python(name = "research_python")

bench_python(
    name = "mqar_smoke",
    module = "fsla_bench.mqar.smoke",
    fsla = True,
)

bench_python(
    name = "mqar_local_grid",
    module = "fsla_bench.mqar.local_grid",
    fsla = True,
)

#: the tests, per area (README.md#tests-and-the-gate): the model and MQAR suites import fsla
bench_python(
    name = "pytest",
    module = "pytest",
    fsla = True,
)

#: the fleet launcher: the jobs it builds name fsla's objects
bench_python(
    name = "fleet",
    module = "fsla_bench.fleet",
    fsla = True,
)

#: the measurement suite, a declared build over fsla-devtools' build system (declare.py)
bench_python(
    name = "suite",
    module = "fsla_devtools.build",
)
