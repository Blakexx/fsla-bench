"""fsla-bench's build graph: its environments and its checks, on fsla-devtools' module (its environment extension and
generic rules). Nothing here names a machine; the front door (bazel/bazel) hands Bazel the machine's settings."""

module(name = "fsla_bench")

bazel_dep(name = "bazel_skylib", version = "1.9.2")

#: THE GRAPH'S SHARED MACHINERY, fsla-devtools' module, at a public commit: the front door overrides it with the
#: machine's checkout (a fresh machine clones one at this commit first)
bazel_dep(name = "fsla_devtools", version = "0.1.0")
git_override(
    module_name = "fsla_devtools",
    commit = "6781f2a752a4a95ce7566fd2b05942e0c27ffcb1",
    remote = "https://github.com/Blakexx/fsla-devtools.git",
)

#: THE ENVIRONMENTS (fsla-devtools' environment extension): the pinned uv; `bench_env`, the fork's stack on fsla's
#: torch, which the gate, the tests and the local runs import; `research_env`, the baselines' stack (torch 2.6, the
#: flash-attn wheel, upstream fla); the tracked tree. The packages no index serves are pinned by public commit.
environment = use_extension("@fsla_devtools//bazel:environment.bzl", "environment")
environment.pinned(
    name = "uv",
    build = 'exports_files(["{binary}"], visibility = ["//visibility:public"])\n',
    pin = "@fsla_devtools//pins:uv_pin.json",
)
environment.python(
    name = "bench_env",
    #: zoology's build imports torch: the packages build against the environment
    isolated_builds = False,
    index = "https://download.pytorch.org/whl/cu130",
    lock = "//:requirements.lock",
    packages = [
        "flash-linear-attention @ git+https://github.com/Blakexx/flash-linear-attention@a9a5c3dfd1b5e0335e8ee07ba96923fcb6afc0ed",
        "zoology @ git+https://github.com/Blakexx/fsla-zoology@8befca418e90ae0bf6fe45fb892d8eae885169f2",
        "chromatic-recall @ git+https://github.com/Blakexx/chromatic-recall@ffdd03b3582b6c82af27fa00f19950c1378e652e",
        "fleet @ git+https://github.com/Blakexx/fleet@d2b4fa3c4ba2a47d5c89c8e5c3e2dad329ff8b83",
    ],
    uv = "@uv//:uv",
    uv_pin = "@fsla_devtools//pins:uv_pin.json",
)
environment.python(
    name = "research_env",
    isolated_builds = False,
    index = "https://download.pytorch.org/whl/cu124",
    lock = "//:research.lock",
    packages = [
        "zoology @ git+https://github.com/Blakexx/fsla-zoology@8befca418e90ae0bf6fe45fb892d8eae885169f2",
        "chromatic-recall @ git+https://github.com/Blakexx/chromatic-recall@ffdd03b3582b6c82af27fa00f19950c1378e652e",
        "fleet @ git+https://github.com/Blakexx/fleet@d2b4fa3c4ba2a47d5c89c8e5c3e2dad329ff8b83",
    ],
    uv = "@uv//:uv",
    uv_pin = "@fsla_devtools//pins:uv_pin.json",
)
environment.tree(name = "bench_tree")
environment.docrefs(name = "docrefs")
#: THE CELLS every session runs on, the central registry's (`@fsla_cells//:<cell>`, `@fsla_cells//:cells.bzl`)
environment.cells(
    name = "fsla_cells",
    uv = "@uv//:uv",
    uv_pin = "@fsla_devtools//pins:uv_pin.json",
)

#: THE BUNDLES (fsla-devtools' `bundle` tag): fsla's timing entries, clock reader and diff sides, each built in its own
#: workspace by its own pins and consumed here, so two commits are entries of ONE session. The CANDIDATE is the fsla
#: checkout a run names (`--repo_env=FSLA_CANDIDATE=PATH`: a module names no machine path), built in place; the
#: REFERENCE is a commit of fsla, moved like a pin.
environment.bundle(
    name = "candidate",
    uv = "@uv//:uv",
    uv_pin = "@fsla_devtools//pins:uv_pin.json",
    worktree_env = "FSLA_CANDIDATE",
)
environment.bundle(
    name = "reference",
    commit = "14daa4d062a3348c12fbbe6dba03ebc210ca2d46",
    remote = "https://github.com/Blakexx/fsla.git",
    uv = "@uv//:uv",
    uv_pin = "@fsla_devtools//pins:uv_pin.json",
)
use_repo(environment, "bench_env", "bench_tree", "candidate", "docrefs", "fsla_cells", "reference", "research_env", "uv")

#: THE GROUPS (`fsla_bench/measure/groups.py`) as Starlark, checked against the central registry, for the sessions'
#: macro (`measure/sessions.bzl`)
groups = use_extension("//bazel:groups.bzl", "groups")
use_repo(groups, "bench_groups")
